{
  "name": "vertical-text-viewer-app",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "npm@12.2.1",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run build-search-index",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "update-index": "tsx scripts/update-index.ts",
    "build-search-index": "tsx scripts/build-search-index.ts",
    "build-gaiji-table": "tsx scripts/build-gaiji-table.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.127.1"
  },
  "allowScripts": {
    "esbuild": true,
    "agent-browser": true,
    "fsevents": true,
    "workerd": true
  },
  "devDependencies": {
    "agent-browser": "^0.39.1",
    "pagefind": "^1.5.2",
    "tsx": "^4.23.13"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.30.1"
    }
  }
}
