---
/**
 * 五十音から著者を探す画面。
 * 行を押すと下に著者一覧が展開する。著者は全員(1,020人)分をページに含めており、
 * 行の切り替えでページ遷移は起きない。
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ROWS, authorsInRow } from "../../lib/content/browse";

const byRow = ROWS.map((row) => ({
  ...row,
  authors: authorsInRow(row.id).map((a) => ({
    id: a.id,
    name: a.name,
    kana: a.nameKana,
    count: a.workCount,
  })),
}));
---

<BaseLayout title="五十音から探す" description="青空文庫の著者を五十音から探せます。">
  <h1>五十音から探す</h1>
  <p class="lead">行を選ぶと著者が表示されます。</p>

  <nav class="rows" id="rows">
    {
      byRow.map((row) => (
        <button type="button" data-row={row.id} aria-pressed="false">
          <span class="label">{row.label}</span>
          <span class="count">{row.authors.length}人</span>
        </button>
      ))
    }
  </nav>

  {
    byRow.map((row) => (
      <section class="group" data-row={row.id} hidden>
        <h2>{row.label}の著者</h2>
        <ul class="list">
          {row.authors.map((a) => (
            <li>
              <a href={`/authors/${a.id}`}>{a.name}</a>
              <span class="meta">{a.kana} · {a.count}作品</span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("#rows button");
  const groups = document.querySelectorAll<HTMLElement>(".group");

  const show = (rowId: string | null, updateUrl = true) => {
    for (const b of buttons) b.setAttribute("aria-pressed", String(b.dataset.row === rowId));
    for (const g of groups) g.hidden = g.dataset.row !== rowId;

    if (!updateUrl) return;
    const url = new URL(location.href);
    if (rowId) url.searchParams.set("row", rowId);
    else url.searchParams.delete("row");
    history.replaceState(null, "", url);
  };

  for (const b of buttons) {
    b.addEventListener("click", () => {
      // 同じ行をもう一度押したら閉じる
      const open = b.getAttribute("aria-pressed") === "true";
      show(open ? null : b.dataset.row!);
    });
  }

  show(new URLSearchParams(location.search).get("row"), false);
</script>

<style>
  .rows {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(6rem, 1fr));
    gap: 0.6rem;
    margin-bottom: 1.5rem;
  }
  .rows button {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.8rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: #fff;
    font: inherit;
    color: inherit;
    cursor: pointer;
    text-align: start;
  }
  .rows button:hover {
    border-color: var(--accent);
  }
  .rows button[aria-pressed="true"] {
    border-color: var(--accent);
    background: var(--accent);
    color: #fff;
  }
  .label {
    font-size: 1.05rem;
    font-weight: 600;
  }
  .count {
    font-size: 0.75rem;
    opacity: 0.75;
  }

  .group h2 {
    font-size: 1rem;
    margin: 0 0 0.5rem;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .list li {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    flex-wrap: wrap;
    padding: 0.5rem 0.25rem;
    border-bottom: 1px solid var(--line);
  }
  .meta {
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
