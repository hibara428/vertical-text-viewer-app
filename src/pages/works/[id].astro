---
// 作品ページ。リクエストのたびにエッジで本文を取得・パースする。
import { env } from "cloudflare:workers";
import Reader from "../../components/reader/Reader.astro";
import SiteName from "../../components/SiteName.astro";
import { loadWorkText } from "../../lib/content/work-text";
import { findWork, type Person } from "../../lib/content/index-lookup";
import people from "../../data/index/people.json";
import { parse } from "../../lib/aozora/parse";
import "../../styles/global.css";

export const prerender = false;

const id = Astro.params.id!;
const work = await findWork(id);
if (!work) return new Response("作品が見つかりません", { status: 404 });

const loaded = await loadWorkText(work.id, work.sourceUrl, env.WORK_TEXT);
const parsed = parse(loaded.text);

const directory = people as Record<string, Person>;
const credits = work.contributors.map((c) => ({
  role: c.role,
  personId: c.personId,
  name: directory[c.personId]?.name ?? c.personId,
}));
const author = credits.find((c) => c.role === "著者") ?? credits[0];
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{work.title} — {author?.name ?? ""}</title>
    <meta name="description" content={`${work.title}(${author?.name ?? ""})を読む。`} />
  </head>
  <body>
    <Reader
      bodyHtml={parsed.bodyHtml}
      title={work.title}
      author={author?.name ?? ""}
      colophon={parsed.colophon}
      cardUrl={work.cardUrl}
    >
      <header class="chrome" slot="chrome">
        <SiteName compact />
        <p class="work">{work.title}</p>
      </header>
    </Reader>

    <style is:global>
      :root {
        --ink: #1a1a1a;
        --muted: #666;
        --line: #ddd;
        --paper: #fdfcf8;
        --accent: #7a4b3a;
      }
      * {
        box-sizing: border-box;
      }
      /* サイトのUIはゴシック。明朝は本文にだけ当てる(Reader 側) */
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: "Hiragino Sans", "Yu Gothic", system-ui, sans-serif;
        line-height: 1.7;
      }
      a {
        color: var(--accent);
      }

      /* 読書中も操作できるよう画面上部に留める。
         左にサイト名、中央に作品名、右に操作。左右を同じ幅にすることで
         作品名がきっちり中央に来る。狭い画面では作品名だけが縮む */
      .chrome {
        position: sticky;
        top: 0;
        z-index: 2;
        display: grid;
        grid-template-columns: 1fr minmax(0, auto) 1fr;
        gap: 0.9rem;
        align-items: center;
        padding: 0.6rem 1rem;
        border-bottom: 1px solid var(--line);
        background: #fff;
      }
      /* 作品名は本文と同じ明朝で組む。入りきらなければ末尾を省く */
      .chrome .work {
        margin: 0;
        min-width: 0;
        text-align: center;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        font-family: "Hiragino Mincho ProN", "Yu Mincho", serif;
        font-size: 1.05rem;
      }

    </style>
  </body>
</html>
