---
/**
 * 本文ビューア。読み方モードを切り替えられる。
 *
 * ここが持つのは本文(扉・本文・底本)と、モードの切り替えだけ。
 * レイアウトはモードごとのコンポーネントが持つ。混ぜると、あるモードの都合が
 * 他のモードへ漏れる。詳細は docs/viewer-design.md を参照。
 */
import BlogMode from "./BlogMode.astro";
import ColumnsMode from "./ColumnsMode.astro";
import PageMode from "./PageMode.astro";
import ScrollXMode from "./ScrollXMode.astro";

type Props = {
  bodyHtml: string;
  title: string;
  author: string;
  /** 底本情報。本文の続きとして最後に置く */
  colophon: string[];
  cardUrl: string;
};
const { bodyHtml, title, author, colophon, cardUrl } = Astro.props;

/** 読み方モード。並びは送り方の刻みが細かい順にしている */
const MODES = [
  { id: "vertical-page", label: "ページ", ready: true },
  { id: "vertical-scroll-x", label: "巻物", ready: true },
  { id: "vertical-columns", label: "縦段組", ready: true },
  { id: "horizontal", label: "ブログ", ready: true },
] as const;

const DEFAULT_MODE = "vertical-page";
---

<!--
  呼び出し側から渡されたヘッダーの中に操作を差し込む。
  ヘッダーを二段にしないため。
-->
<slot name="chrome" />

<div id="reader" data-mode={DEFAULT_MODE}>
  <article class="body">
    <!-- 本文の書き出しにも作品名と著者名を置く。書籍の扉にあたる -->
    <h2 class="work-title">{title}</h2>
    <p class="work-author">{author}</p>
    <Fragment set:html={bodyHtml} />

    <!-- 底本情報は本文の続き。ページモードでも最後の紙面として現れる -->
    <footer class="colophon">
      {colophon.map((line) => <p>{line}</p>)}
      <p><a href={cardUrl}>青空文庫の図書カード</a></p>
    </footer>
  </article>
</div>

<template id="reader-controls">
  {/*
    読書中の設定はまとめて畳んでおく。狭い画面ではボタンを並べる幅がなく、
    広い画面でも読書の邪魔になる。読み方以外の設定もここへ足していく
  */}
  <div class="controls">
    <button type="button" class="menu-button" aria-expanded="false" aria-controls="reader-menu">
      <svg class="mark" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <span class="label">設定</span>
    </button>
    <div class="menu" id="reader-menu" hidden>
      <p class="menu-heading">読み方</p>
      <nav class="modes" aria-label="読み方">
        {
          MODES.filter((m) => m.ready).map((m) => (
            <button type="button" data-mode={m.id} aria-pressed="false">
              {m.label}
            </button>
          ))
        }
      </nav>
    </div>
  </div>
</template>

<!-- モードごとのレイアウト -->
<PageMode />
<ScrollXMode />
<ColumnsMode />
<BlogMode />

<script>
  import { frameHeight } from "../../lib/reader/metrics";
  import type { ModeContext, ReaderMode } from "../../lib/reader/mode";
  import { blogMode } from "../../lib/reader/blog";
  import { columnsMode } from "../../lib/reader/columns";
  import { pageMode } from "../../lib/reader/page";
  import { scrollXMode } from "../../lib/reader/scroll-x";

  const reader = document.getElementById("reader")!;
  const ctx: ModeContext = {
    reader,
    body: reader.querySelector<HTMLElement>(".body")!,
  };

  // 実装を明示的に並べる。自動登録にすると読み込み順に依存して壊れる
  const MODES = new Map<string, ReaderMode>(
    [pageMode, scrollXMode, columnsMode, blogMode].map((m) => [m.id, m]),
  );

  // 操作をヘッダーの中へ移す。ヘッダーは呼び出し側が組み立てるため、
  // ここでは差し込む位置だけを決める
  const template = document.getElementById("reader-controls") as HTMLTemplateElement;
  document.querySelector(".chrome")!.append(template.content.cloneNode(true));
  template.remove();

  const buttons = document.querySelectorAll<HTMLButtonElement>(".modes [data-mode]");
  const KEY = "reading-mode";

  // 設定の開け閉め。開いているあいだだけ外側の操作を見る
  const menuButton = document.querySelector<HTMLButtonElement>(".menu-button")!;
  const menu = document.getElementById("reader-menu")!;
  const setMenu = (open: boolean) => {
    menu.hidden = !open;
    menuButton.setAttribute("aria-expanded", String(open));
  };
  menuButton.addEventListener("click", (e) => {
    e.stopPropagation(); // 送りのクリックと二重にしない
    setMenu(menu.hidden);
  });
  // 外を押したときと Esc で閉じる。読書に戻る動きを塞がない
  document.addEventListener("click", (e) => {
    if (!menu.hidden && !(e.target as Element).closest(".controls")) setMenu(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !menu.hidden) setMenu(false);
  });

  /**
   * モードを切り替える。
   *
   * 前のモードに後始末をさせてから次を組み立てる。順番を逆にすると、
   * 前のモードが入れたインラインスタイルが残って次の測定を狂わせる。
   *
   * 読書位置の保持はいまは行わず、常に先頭から表示する。ビューアの構造が
   * まだ固まっておらず、先に作り込んでも土台が変われば作り直しになるため。
   */
  let current: ReaderMode | null = null;

  const apply = (id: string) => {
    const next = MODES.get(id);
    if (!next) return;

    current?.unmount(ctx);
    current = next;

    reader.dataset.mode = id;
    // 縦書きの扉はモードをまたいで同じなので、共通の目印で掛ける
    if (next.vertical) reader.dataset.vertical = "";
    else delete reader.dataset.vertical;
    for (const b of buttons) b.setAttribute("aria-pressed", String(b.dataset.mode === id));
    try {
      localStorage.setItem(KEY, id);
    } catch {
      // 保存できなくても読書は続けられる
    }

    next.mount(ctx);
    lastSize = `${frameHeight()}x${reader.clientWidth}`;
  };

  for (const b of buttons) {
    b.addEventListener("click", (e) => {
      e.stopPropagation();
      apply(b.dataset.mode!);
      setMenu(false);
    });
  }

  /*
   * 画面の大きさが変わると1行に入る文字数も変わるため、測り直す。
   *
   * ただし**寸法が変わっていなければ組み直さない**。組み直すこと自体が
   * 巻物の文字出しを打ち切り、読書位置を計算し直す。スマホではアドレスバーの
   * 伸縮で resize が飛んでくるが、高さは svh で測っているので値は変わらない
   */
  let resizing: number | undefined;
  let lastSize = "";
  const relayout = () => {
    const size = `${frameHeight()}x${reader.clientWidth}`;
    if (size === lastSize) return;
    lastSize = size;
    current?.resize?.(ctx);
  };
  window.addEventListener("resize", () => {
    clearTimeout(resizing);
    resizing = window.setTimeout(relayout, 200);
  });

  let saved: string | null = null;
  try {
    saved = localStorage.getItem(KEY);
  } catch {
    // 読めなければ既定のモードで始める
  }
  // 選べないモードが保存されている場合(名前を変えた・まだ作っていない)は既定に戻す。
  // 既定はボタンの先頭。フロントマターの定数はここから参照できない
  const selectable = [...buttons].map((b) => b.dataset.mode!);
  apply(saved && selectable.includes(saved) ? saved : selectable[0]!);
</script>

<style is:global>
  /* ── 読書中の設定 ── */
  .controls {
    position: relative;
    justify-self: end;
    font-family: "Hiragino Sans", "Yu Gothic", system-ui, sans-serif;
  }
  .menu-button {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: #fff;
    font: inherit;
    font-size: 0.8rem;
    color: inherit;
    cursor: pointer;
  }
  .menu-button:hover,
  .menu-button[aria-expanded="true"] {
    border-color: var(--accent);
  }
  .menu-button .mark {
    inline-size: 1.15em;
    block-size: 1.15em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  /* 狭い画面では文字を落としてアイコンだけにする */
  @media (max-width: 640px) {
    .menu-button .label {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }

  .menu {
    position: absolute;
    inset-inline-end: 0;
    inset-block-start: calc(100% + 0.4rem);
    min-inline-size: 11rem;
    padding: 0.6rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: #fff;
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.08);
  }
  .menu-heading {
    margin: 0 0 0.4rem;
    font-size: 0.7rem;
    color: var(--muted);
  }

  .modes {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.85rem;
  }
  .modes button {
    padding: 0.4rem 0.6rem;
    border: 1px solid transparent;
    border-radius: 4px;
    background: none;
    font: inherit;
    color: inherit;
    text-align: start;
    cursor: pointer;
  }
  .modes button:hover {
    border-color: var(--line);
  }
  .modes button[aria-pressed="true"] {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  /* ── モード共通の値 ──
     ここに置くのは、モードが読んで使う「値」だけにする。
     レイアウトの指定そのものを書くと、上書き漏れが不具合になる。 */
  #reader {
    /* 余白は本文の文字を基準にする。文字サイズを変えても比率が保たれる。
       rem はルート要素基準なので本文に連動しない */
    font-size: 1.125rem;
    /* ヘッダーと本文のあいだ。全モードで同じだけ空ける */
    --space-top: 4em;
    /* 本文の左右 */
    --space-side: 1.5em;
  }

  /* ── 本文の体裁 ──
     文字そのものの見え方。どのモードでも変わらない */
  .body {
    /* 扉(作品名・著者名)の大きさ。既定は本文と同じ */
    --title-size: 1em;
    --author-size: 1em;
    /* 1行の長さ。文字数を基準にしているので、文字を大きくしても行長が保たれる */
    --measure: 38em;
    /* 行間。縦書きは行が横に並ぶため、詰めすぎると隣の行と混ざる */
    --leading: 1.9;
    /* 読書用に本文を大きく取る */
    --body-size: 1.125rem;
    /*
     * 1行ぶんの太さ。**rem で持つ**。
     *
     * 空きを行の整数倍にそろえるのに使う。em だと使う場所の文字サイズが
     * 基準になり、底本(0.72em)の中では別の長さになってしまう
     */
    --line: calc(var(--leading) * var(--body-size));
    /* 1紙面の行数。紙面の幅はこれと行送りの掛け算で決まるので、文字や行間を
       変えても行数は変わらない。ページと巻物で同じ分量にするため共通に置く */
    --page-lines: 20;

    font-family: "Hiragino Mincho ProN", "Yu Mincho", serif;
    font-size: var(--body-size);
    line-height: var(--leading);
    /* 均等割り。指定しないと禁則で送られた文字のぶん行末が不揃いになる。
       余りを字間へ配るのでその行はマス目から外れるが、紙の組版も同じことをする */
    text-align: justify;
  }
  .body p {
    margin: 0;
    /*
     * 段落の1行だけが紙面や帯をまたぐのを許す。
     *
     * Chrome の既定は 2 で、孤立行を避けるために行を次の紙面へ送り出す。
     * その結果、紙面ごとに18〜20行とばらついていた。日本語の書籍は版面の
     * 行数が必ず揃っており、孤立行は組版の段階で追い込み・追い出しをして
     * 避ける。ブラウザにその調整はできないので、揃う方を採る
     */
    orphans: 1;
    widows: 1;
  }
  .body rt {
    font-size: 0.5em;
  }
  .body .boten {
    font-style: normal;
    text-emphasis: filled sesame;
  }
  .body .gaiji {
    /* 面区点→Unicode変換までの暫定表示 */
    border-bottom: 1px dotted #999;
  }
  .body .heading {
    margin: 0;
    font-size: 1.1em;
    font-weight: normal;
    /* ページや段の切れ目が見出しの直後に来ないようにする */
    break-after: avoid;
  }
  /* 空行(場面転換)の間隔。縦横どちらの組みでも進行方向に空ける */
  .body .gap {
    block-size: var(--line);
  }

  /* 字下げ。縦書きでは行頭が上、横書きでは左になるが、どちらも「行の始まり」
     なので text-indent でそろう。字数はパーサーが --indent に入れる */
  .body .indent {
    text-indent: calc(var(--indent, 0) * 1em);
  }
  /* 地付き・字上げ。行末(縦書きでは下)へ寄せ、--hang の字数だけ空ける */
  .body .hang {
    text-align: end;
    padding-inline-end: calc(var(--hang, 0) * 1em);
  }

  /* 本文冒頭の扉。位置と大きさはモードごとに決める */
  .body .work-title {
    margin: 0;
    font-size: var(--title-size);
    font-weight: normal;
  }
  .body .work-author {
    /* 本文との間隔。margin-bottom だと縦書きで著者名の真下が空いてしまうので、
       書字方向に追従する論理プロパティで指定する */
    margin: 0;
    margin-block-end: 3em;
    font-size: var(--author-size);
  }

  /* ── 縦書きの扉 ──
     縦書きの3モードで同じ体裁。文字を大きくすると行の位置がずれるため、
     大きさは本文のままにし、字下げだけで作る。
     縦書きかどうかはモード自身が申告し、Reader が目印を持たせる */
  #reader[data-vertical] .work-title {
    /* 行頭(縦書きでは上)から二文字ぶん下げる */
    text-indent: 2em;
  }
  #reader[data-vertical] .work-author {
    /* 行末(縦書きでは下)にそろえ、そこから二文字ぶん空ける */
    text-align: end;
    padding-inline-end: 2em;
    /*
     * 本文とのあいだに一行ぶん空ける。
     *
     * **行送りの整数倍にする。** 半端があると、以降の行がすべてマス目から
     * ずれ、紙面に入る行数もひとつ減る。実測では 1em(0.53行)を2つ重ねて
     * 1.06行になっており、扉のある紙面だけ行数が合わなかった
     */
    margin-block-end: var(--line);
  }

  /* ── 送りのカーソル ──
     画面の左右で送るモードが data-side を持たせる。動く向きを矢印で示す。
     w-resize などの標準カーソルはリサイズの見た目で、移動には読めない。
     矢印は白で縁取り、本文の上でも輪郭が見えるようにしている */
  #reader[data-side="next"] {
    cursor: url("data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%2724%27%20height%3D%2724%27%20viewBox%3D%270%200%2024%2024%27%3E%3Cpath%20d%3D%27M20%2012H6M12%206l-6%206%206%206%27%20fill%3D%27none%27%20stroke%3D%27%23fff%27%20stroke-width%3D%275%27%20stroke-linecap%3D%27round%27%20stroke-linejoin%3D%27round%27%2F%3E%3Cpath%20d%3D%27M20%2012H6M12%206l-6%206%206%206%27%20fill%3D%27none%27%20stroke%3D%27%231a1a1a%27%20stroke-width%3D%272.5%27%20stroke-linecap%3D%27round%27%20stroke-linejoin%3D%27round%27%2F%3E%3C%2Fsvg%3E") 12 12, w-resize;
  }
  #reader[data-side="prev"] {
    cursor: url("data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%2724%27%20height%3D%2724%27%20viewBox%3D%270%200%2024%2024%27%3E%3Cpath%20d%3D%27M4%2012h14M12%206l6%206-6%206%27%20fill%3D%27none%27%20stroke%3D%27%23fff%27%20stroke-width%3D%275%27%20stroke-linecap%3D%27round%27%20stroke-linejoin%3D%27round%27%2F%3E%3Cpath%20d%3D%27M4%2012h14M12%206l6%206-6%206%27%20fill%3D%27none%27%20stroke%3D%27%231a1a1a%27%20stroke-width%3D%272.5%27%20stroke-linecap%3D%27round%27%20stroke-linejoin%3D%27round%27%2F%3E%3C%2Fsvg%3E") 12 12, e-resize;
  }

  /* 底本情報。本文の続きとして小さく組む。
     区切り線は進行方向の手前側に引くため、縦書きでは縦線、横書きでは横線になる */
  .body .colophon {
    /* 空きは行送りの整数倍。半端があると以降の行がマス目からずれる */
    margin-block-start: calc(var(--line) * 2);
    padding-block-start: var(--line);
    border-block-start: 1px solid var(--line);
    font-size: 0.72em;
    color: var(--muted);
  }
  .body .colophon p {
    margin: 0;
  }
</style>
